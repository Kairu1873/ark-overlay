{
  "name": "ark-timer",
  "productName": "ARKタイマー",
  "version": "1.0.0",
  "description": "ARK用マルチタイマー（孵化・インプリントなど）",
  "main": "electron/main.js",
  "author": "Kairu1873",
  "license": "MIT",
  "scripts": {
    "build:web": "esbuild src/app.js --bundle --format=iife --target=es2019 --outfile=www/app.js",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win nsis --publish never",
    "data:fetch": "node tools/fetch-wiki.mjs",
    "data:validate": "node tools/validate-data.mjs",
    "test": "node tools/test-timers.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.kairu.arktimer",
    "productName": "ARKタイマー",
    "files": ["electron/**", "www/**", "data/**", "package.json", "!node_modules/**"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "ARKTimer-Setup-${version}.exe" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "ARKタイマー" }
  }
}
