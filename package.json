{
  "name": "ark-overlay",
  "productName": "ARK Overlay",
  "version": "1.2.0",
  "description": "ARK用オーバーレイ（タイマー・生物データ）",
  "main": "electron/main.js",
  "author": "Kairu",
  "license": "MIT",
  "scripts": {
    "build:web": "esbuild src/app.js --bundle --format=iife --target=es2019 --outfile=www/app.js",
    "start": "npm run build:web && electron .",
    "dist:win": "npm run build:web && electron-builder --win nsis --publish never",
    "data:fetch": "node tools/fetch-wiki.mjs",
    "data:validate": "node tools/validate-data.mjs",
    "test": "node tools/test-timers.mjs && node tools/test-search.mjs && node tools/test-taming.mjs && node tools/test-stats.mjs && node tools/test-items.mjs"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0"
  },
  "build": {
    "appId": "com.kairu.arkoverlay",
    "productName": "ARK Overlay",
    "files": [
      "electron/**",
      "www/**",
      "data/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Kairu1873",
        "repo": "ark-overlay"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "ARKOverlay-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ARK Overlay",
      "createDesktopShortcut": false,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
